# Optional Google Drive backup/restore.
# Create a browser OAuth Client ID in Google Cloud Console and enable the Drive API.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional in-app AI assistant server fallback.
# By default users bring their own API key in the assistant settings. The key is
# saved in their browser and forwarded through this server without being stored.
# Set the variables below only if you want a deployment-wide fallback key.
#
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_REASONING=low

# OpenRouter example:
# AI_API_KEY=sk-or-v1-...
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=deepseek/deepseek-v4.1-flash-1017

# Local Ollama example (keeps tournament data on your machine):
# AI_API_KEY=ollama
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1

# Optional metadata sent to OpenRouter-compatible providers:
# AI_APP_NAME=Swiss Pairing
# AI_APP_URL=https://your-app.example.com

# Optional allowlist for browser-supplied base URLs. Use this on public deployments
# to prevent the assistant proxy from reaching arbitrary endpoints.
# Comma-separated. Leave unset for local development.
# AI_ALLOWED_BASE_URLS=https://api.openai.com/v1,https://openrouter.ai/api/v1

# Set to false to hide the assistant UI entirely.
# NEXT_PUBLIC_AI_ASSISTANT_ENABLED=true
